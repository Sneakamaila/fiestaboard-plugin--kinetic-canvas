        "display_layout": "full_canvas",
        "refresh_seconds": 300
      },
      "template": [
        "{{kinetic_canvas.note_line1}}",
        "{{kinetic_canvas.note_line2}}",
        "{{kinetic_canvas.note_line3}}"
      ],
      "line_metadata": [
        { "alignment": "left", "wrap": false },
        { "alignment": "left", "wrap": false },
        { "alignment": "left", "wrap": false }
      ]
    }
  }
