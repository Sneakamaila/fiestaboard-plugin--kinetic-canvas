{
  "id": "kinetic_canvas",
  "name": "Kinetic Canvas & Acoustic Art",
  "version": "1.0.2",
  "description": "Abstract generative art and kinetic split-flap acoustic soundscapes for Vestaboard Note and Flagship.",
  "author": "Sneakamaila",
  "icon": "palette",
  "category": "art",
  "repository": "https://github.com/Sneakamaila/fiestaboard-plugin--kinetic-canvas",
  "documentation": "README.md",
  "settings_schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "title": "Art & Sound Mode",
        "description": "Select the generative art style and acoustic sound profile.",
        "default": "cycle",
        "enum": [
          "cycle",
          "zen_snap",
          "zen_wave",
          "zen_rain",
          "zen_gong",
          "mondrian",
          "game_of_life",
          "wolfram",
          "weather",
          "zen_chime"
        ],
        "enumNames": [
          "Ausstellungs-Zyklus (Wechselt alle Stile)",
          "Staccato Snap (Synchroner Farbsprung, Δ=1)",
          "Klangwelle (Spektraler Stereo-Sweep)",
          "Nachtregen (Sanftes Klick-Prasseln)",
          "Resonanz-Mandala (Klangschale)",
          "Mondrian & De Stijl (Farbflaechen)",
          "Conway's Game of Life (Lebende Zellen)",
          "Wolfram 1D Automaten (Muster-Teppiche)",
          "Wetter-Resonanz (Live-Wetter Kunst)",
          "Zen Chime (Alle Klangskulpturen im Wechsel)"
        ]
      },
      "display_layout": {
        "type": "string",
        "title": "Board Layout Preset",
        "description": "Choose whether the board shows pure full-screen art or includes title & sound telemetry.",
        "default": "full_canvas",
        "enum": [
          "full_canvas",
          "canvas_with_info"
        ],
        "enumNames": [
          "Pure Full-Screen Canvas (100% Abstract Art)",
          "Art Canvas with Sound Badge (Art + Title & Acoustic Waveform)"
        ]
      },
      "chime_style": {
        "type": "string",
        "title": "Zen Chime Sound Profile",
        "description": "Specific acoustic sound envelope when Zen Chime mode is active.",
        "default": "cycle",
        "enum": [
          "cycle",
          "staccato_snap",
          "acoustic_wave",
          "rainfall",
          "harmonic_decay"
        ],
        "enumNames": [
          "Auto-Cycle All Envelopes",
          "Staccato Snap (Crisp unison crack, Δ=1)",
          "Acoustic Wave (Stereo pan sweep)",
          "Mechanical Rainfall (Gentle stochastic patter)",
          "Harmonic Decay (Singing bowl resonance)"
        ]
      },
      "wolfram_rule": {
        "type": "integer",
        "title": "Wolfram Rule Number",
        "description": "Cellular rule for Wolfram tapestries (30 = chaotic, 90 = Sierpinski, 110 = complex).",
        "default": 30,
        "enum": [30, 90, 110, 184],
        "enumNames": [
          "Rule 30 (Chaotic Turbulence)",
          "Rule 90 (Sierpinski Fractal)",
          "Rule 110 (Complex Turing-Complete)",
          "Rule 184 (Traffic Flow)"
        ]
      },
      "city_name": {
        "type": "string",
        "title": "Weather Location (City Name)",
        "description": "Display name of your location for weather resonance.",
        "default": "Berlin"
      },
      "latitude": {
        "type": "number",
        "title": "Weather Latitude",
        "description": "Latitude coordinate for Open-Meteo weather API (e.g. 52.52)",
        "default": 52.52
      },
      "longitude": {
        "type": "number",
        "title": "Weather Longitude",
        "description": "Longitude coordinate for Open-Meteo weather API (e.g. 13.405)",
        "default": 13.405
      },
      "demo_mode": {
        "type": "boolean",
        "title": "Weather Demo Mode",
        "description": "Simulate atmospheric weather data without internet requests.",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "Interval between kinetic transitions (minimum 30 seconds to preserve hardware).",
        "default": 300,
        "minimum": 30,
        "maximum": 3600
      }
    }
  },
  "variables": {
    "groups": {
      "art": {
        "label": "Artwork & Style Details"
      },
      "acoustics": {
        "label": "Acoustic Score & Telemetry"
      },
      "flagship": {
        "label": "Vestaboard Flagship Layout (22x6)"
      },
      "note": {
        "label": "Vestaboard Note Layout (15x3)"
      }
    },
    "simple": {
      "title": {
        "description": "Poetic title of the current artwork composition",
        "type": "string",
        "group": "art",
        "example": "Composition #402 in Rot, Gelb und Blau"
      },
      "mode": {
        "description": "Currently active art engine mode",
        "type": "string",
        "group": "art",
        "example": "mondrian"
      },
      "description": {
        "description": "Detailed description of the visual piece or current simulation state",
        "type": "string",
        "group": "art",
        "example": "Mondrian-Komposition mit primären Farbfeldern"
      },
      "sound_profile": {
        "description": "Acoustic intensity category (Silent, Whisper, Rainfall, Crescendo, Thunder)",
        "type": "string",
        "group": "acoustics",
        "example": "Rainfall"
      },
      "total_clicks": {
        "description": "Total mechanical flap clicks generated in this transition",
        "type": "integer",
        "group": "acoustics",
        "example": 412
      },
      "moving_modules": {
        "description": "Count of physical modules that rotated during this transition",
        "type": "integer",
        "group": "acoustics",
        "example": 38
      },
      "duration_sec": {
        "description": "Estimated acoustic duration of the mechanical transition",
        "type": "string",
        "group": "acoustics",
        "example": "1.4s"
      },
      "acoustic_sparkline": {
        "description": "ASCII sparkline of acoustic activity across board columns",
        "type": "string",
        "group": "acoustics",
        "example": "..-==#==--.."
      },
      "acoustic_description": {
        "description": "Human-readable acoustic score summary",
        "type": "string",
        "group": "acoustics",
        "example": "Sanftes Regen-Prasseln (412 Klicks, 38 Module, ~1.4s)"
      },
      "flagship_line1": {
        "description": "Line 1 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "flagship_line2": {
        "description": "Line 2 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "flagship_line3": {
        "description": "Line 3 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "flagship_line4": {
        "description": "Line 4 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "flagship_line5": {
        "description": "Line 5 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "flagship_line6": {
        "description": "Line 6 formatted for Vestaboard Flagship (22 tiles)",
        "type": "string",
        "group": "flagship"
      },
      "note_line1": {
        "description": "Line 1 formatted for Vestaboard Note (15 tiles)",
        "type": "string",
        "group": "note"
      },
      "note_line2": {
        "description": "Line 2 formatted for Vestaboard Note (15 tiles)",
        "type": "string",
        "group": "note"
      },
      "note_line3": {
        "description": "Line 3 formatted for Vestaboard Note (15 tiles)",
        "type": "string",
        "group": "note"
      },
      "canvas_flagship_line1": {
        "description": "Full canvas Line 1 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_flagship_line2": {
        "description": "Full canvas Line 2 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_flagship_line3": {
        "description": "Full canvas Line 3 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_flagship_line4": {
        "description": "Full canvas Line 4 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_flagship_line5": {
        "description": "Full canvas Line 5 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_flagship_line6": {
        "description": "Full canvas Line 6 for Vestaboard Flagship (always pure art)",
        "type": "string",
        "group": "flagship"
      },
      "canvas_note_line1": {
        "description": "Full canvas Line 1 for Vestaboard Note (always pure art)",
        "type": "string",
        "group": "note"
      },
      "canvas_note_line2": {
        "description": "Full canvas Line 2 for Vestaboard Note (always pure art)",
        "type": "string",
        "group": "note"
      },
      "canvas_note_line3": {
        "description": "Full canvas Line 3 for Vestaboard Note (always pure art)",
        "type": "string",
        "group": "note"
      }
    }
  },
  "teaser": "{63}{65}{67} CANVAS",
